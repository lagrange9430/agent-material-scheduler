# ---- 模型接入（可选）----
# 不配置 DEEPSEEK_API_KEY 时，程序自动使用 offline_mock，不联网也能跑通全流程。
# 本文件可直接复制为 .env；.env 已被 .gitignore 忽略，不会随仓库提交。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# 运行模式：auto | mock | llm
#   auto  有 key 用 llm，无 key 回落 mock（默认）
#   mock  强制离线，结果可复现
#   llm   强制真实模型，无 key 直接报错退出
AGENT_MODE=auto

# 超时（秒）
MODEL_TIMEOUT=60
